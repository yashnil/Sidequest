# Sidequest environment
#
# Nothing in this file is required for the current vertical slice: trip creation,
# the questionnaire, regional expansion, fit scoring, the Discovery Board and the
# weather layer all run against curated seed data, a local SQLite database and a
# keyless public weather API — zero credentials.
#
# Each entry below is recorded here so the blocking dependency is visible before
# the phase that needs it starts. See .claude-private/PROGRESS.md (B1-B4).

# Port for the web app and the end-to-end suite. You do not normally set this:
# the canonical value lives in `config.port` in the root package.json (4200), and
# the root `dev` and `start` scripts export it as PORT. Set it here only to
# override that default for a single machine.
# PORT=4200

# Local database file used by the SQLite driver (default: ./data/sidequest.db).
# When the Supabase phase lands this is replaced by SUPABASE_* below.
SIDEQUEST_DB_PATH=./data/sidequest.db

# Which weather source runs. Defaults to `openmeteo`.
#
#   openmeteo  the live adapter. Open-Meteo's free tier is non-commercial and
#              needs no key, so this works from a clean clone with no setup.
#              Data is CC BY 4.0 and the attribution is rendered wherever the
#              numbers are; a commercial deployment moves to the `customer-`
#              host with a key, which is one constant and one header.
#   fixture    the deterministic offline generator. What the end-to-end suite
#              runs on, so a browser test asserts against weather it chose
#              rather than against whatever the sky was doing that morning.
#   off        no weather at all. Every day comes back `unavailable`, which is
#              the honest way to see what the product looks like when the source
#              is down. Sunrise and sunset are still computed: the sun is not a
#              prediction and does not come from the provider.
# SIDEQUEST_WEATHER_PROVIDER=openmeteo

# Which food source runs. `off` is the honest way to see what the product looks
# like for a region nobody has food data for: every meal becomes time held rather
# than somewhere named, and every surface says so.
# SIDEQUEST_FOOD_PROVIDER=

# Public-transport routing: `valhalla` means an instance built with GTFS timetable
# data (the public demo server is not one). Off unless named — a blank must not
# make a build appear transit-capable.
# SIDEQUEST_TRANSIT_PROVIDER=

# Place/destination imagery: `wikimedia` | `fixture` | `off`. Live imagery is
# opt-in; unset follows the compiler (fixture stacks get fixtures, everything
# else gets the designed fallback graphics). See lib/providers/wikimedia.ts.
# SIDEQUEST_IMAGERY_PROVIDER=

# --- The global compiler: the open-licensed provider stack ---
#
# Every switch defaults to `off`. That is deliberate and it is the opposite of
# the weather switch above: Open-Meteo is free and keyless, so an unrecognised
# value falling through to live costs nothing. These reach volunteer-run
# services and a billed model, and a typo that silently enables them is not free.
#
# A geocoder, a place source, routing and research must all be on for a dynamic
# compilation to run. A partially configured stack is refused rather than
# half-run, because finding out three stages in that there is no routing
# provider wastes the model calls that came before it.
#
# SIDEQUEST_GEOCODER_PROVIDER=off      # off | nominatim
# SIDEQUEST_PLACE_BACKBONE=off         # off | overture   <- the place source
# SIDEQUEST_POI_PROVIDER=off           # off | overpass   <- fallback only
# SIDEQUEST_ROUTES_PROVIDER=off        # off | valhalla
# SIDEQUEST_RESEARCH_PROVIDER=off      # off | anthropic   <- OPTIONAL: only the
#                                      #   "Explore experiences first" Discovery
#                                      #   Board research. "Build my trip" never
#                                      #   needs it; it needs ANTHROPIC_API_KEY
#                                      #   (or SIDEQUEST_COMPOSER_PROVIDER=fixture).
# SIDEQUEST_SHARED_EVIDENCE=on         # on  | off        <- see below
#
# --- The shared evidence store ---
#
# On by default. Retrieved pages and the facts extracted from them are keyed on
# what a *place* is rather than on which trip found it, so a second trip to the
# same museum reads the first trip's research instead of buying it again.
#
# `SIDEQUEST_SHARED_EVIDENCE=off` bypasses it entirely. Not a flag for a
# half-built feature — it is there because "does the cache explain this result?"
# has to be answerable by turning it off and running again. A caching layer
# nobody can bypass is a caching layer nobody can debug.
#
# What is never shared: anything that depends on a traveller or their dates. Fit
# scores, board selections, route assignment, whether a closure overlaps *this*
# trip. An architecture test fails the build if a traveller field reaches a
# shared cache key. See .claude-private/research/shared-evidence-store.md.
#
# --- The place backbone ---
#
# `SIDEQUEST_PLACE_BACKBONE=overture` reads bounded slices of the Overture Maps
# open place, geographic and division data straight from its published cloud
# files. No credentials, no per-query billing: the cost is bytes and seconds, and
# both are metered by the pack's own budget.
#
# It replaces public Overpass as the *primary* source. `SIDEQUEST_POI_PROVIDER`
# is now a fallback for the case where no pack could be prepared at all; a build
# with the backbone on and Overpass off is the intended shape, and a build with
# neither is refused up front.
#
# Licences differ per layer and per record, and the product renders what each
# one requires. See .claude-private/research/global-place-backbone.md and
# docs/osm-database-boundary.md.
#
# SIDEQUEST_PLACE_CATALOG_URL=https://stac.overturemaps.org/catalog.json
#
# Pin a release by hand to reproduce an old compilation exactly, or to hold a
# known-good release while a new one is evaluated. Unset means "discover the
# latest, then hold it for the length of one build".
# SIDEQUEST_PLACE_RELEASE=
#
# Endpoints. The public instances are for bounded development evaluation only —
# see docs/osm-database-boundary.md. Each of these is the one change needed to
# move to a hosted or self-managed service.
# SIDEQUEST_GEOCODER_URL=https://nominatim.openstreetmap.org
# SIDEQUEST_POI_URL=https://overpass-api.de/api/interpreter
#
# SIDEQUEST_ROUTES_URL — do not leave unset in production. A live Iceland
# hydration run against the public default below measured *individual*
# routing requests running 140s and 198s: it is shared, rate-limited and
# unversioned, and a traveller waiting on an itinerary is not a batch job.
# `RoutingProvider` (packages/compiler/src/providers.ts) does not change —
# pointing this at an operated/self-hosted Valhalla instance is the only
# change a production deployment needs. `npm run doctor` reports whether the
# configured value is this public demo host or a real production endpoint.
# SIDEQUEST_ROUTES_URL=https://valhalla1.openstreetmap.de
#
# --- Routing coverage, and how a trip outside it gets measured (V5 §18) ---
#
# A self-hosted Valhalla holds whatever tiles somebody built it with. This is
# how a real deployment measured **0 of N legs** on a Hong Kong trip: the router
# was alive and correct, it held Iceland tiles, and both variables below were
# unset. Every leg was sent to it, every leg came back `error_code: 171` ("No
# suitable edges near location"), and the verification budget went on requests
# that could never succeed.
#
# The code now learns from the first such refusal and falls through for the rest
# of the build, so an undeclared deployment degrades honestly instead of
# silently. These two variables are what turn honest degradation into a measured
# trip:
#
#   SIDEQUEST_ROUTES_COVERAGE    what the local router actually holds, so a
#                                hopeless request is never sent at all.
#                                Country codes, bboxes (south,west,north,east),
#                                or several separated by ';'.
#                                  SIDEQUEST_ROUTES_COVERAGE=IS
#                                  SIDEQUEST_ROUTES_COVERAGE=63.2,-24.6,66.6,-13.3
#                                  SIDEQUEST_ROUTES_COVERAGE=IS;IE;GB
#
#   SIDEQUEST_ROUTES_GLOBAL_PROVIDER=openrouteservice
#   OPENROUTESERVICE_API_KEY=<api.heigit.org key>
#                                the global fallback. Without it, a trip outside
#                                the local tiles gets Sidequest's own honest
#                                distance estimates, clearly labelled as
#                                estimates, and no leg is ever presented as
#                                measured. With it, those legs are measured on
#                                the global OpenStreetMap graph — direct legs
#                                only, one request at a time, hosted quota.
#
# `npm run doctor` names which of these is missing and what the consequence is.
#
# Required by the Nominatim and Overpass usage policies: a User-Agent that names
# the application and a contact. A stock library agent is explicitly rejected.
# SIDEQUEST_FETCH_USER_AGENT=Sidequest/0.1 (+https://your-domain.example; you@example.com)
#
# Per-compilation ceilings. Exhausting one is a normal outcome: the region comes
# back partial, naming the counter that ran out, rather than quietly smaller.
# SIDEQUEST_COMPILER_MAX_AI_CALLS=
# SIDEQUEST_COMPILER_MAX_ROUTE_ELEMENTS=
# SIDEQUEST_COMPILER_MAX_PAGES=
# SIDEQUEST_COMPILER_TIMEOUT_MS=
#
# Overall wall clock for one compilation (default 12 minutes). The compiler
# degrades to an honest partial at this ceiling; the worker hard-stops a build
# stuck inside a stage at the ceiling plus a 90s grace.
# SIDEQUEST_COMPILER_DEADLINE_MS=
#
# Daily ceilings, enforced before a live build starts and before any billed
# model call anywhere in the product (defaults: 20 live compilations, 300 model
# calls per UTC day). An explicit 0 means "no live builds today"; a malformed
# value falls back to the default rather than to unlimited.
#
# Each is charged twice: once against the deployment, and once against the
# calling browser at a quarter of the same figure. That second share is what
# keeps a cost control from becoming an outage — without it one visitor drains
# the whole day's allowance in about a quarter of an hour and everybody else is
# told to come back tomorrow.
# SIDEQUEST_DAILY_LIVE_COMPILATIONS=
# SIDEQUEST_DAILY_MODEL_CALLS=
#
# How many proxy hops this deployment's own infrastructure appends to
# `x-forwarded-for`. Unset (the default) means there is no proxy in front, and
# the rate limiter then derives **no** address at all rather than trusting the
# header — the leftmost element of it is written by the client, so believing it
# hands any caller a fresh bucket per request. Set it to 1 behind a single
# load balancer, 2 behind two, and the limiter counts that many values from the
# right. Requests that still cannot be attributed are bounded by a
# deployment-wide fence instead.
# SIDEQUEST_TRUSTED_PROXY_HOPS=
#
# Whether the browser cookie that owns every trip carries `Secure`. You do not
# set this. It follows NODE_ENV — on for a production build, off for `npm run
# dev` — because a deployment is served over TLS, which is the same assumption
# the unconditional HSTS header in next.config.ts already makes.
#
# `off` is the one exemption, and it exists for exactly one environment: the
# browser suite runs a *production* build (`next start`) over http://127.0.0.1,
# so it would otherwise be asking a plaintext origin to store a Secure cookie
# and betting the whole suite on a browser treating loopback as trustworthy.
# Any value but the exact string `off` leaves the attribute on, so a deployment
# cannot lose it to a blank or a typo.
# SIDEQUEST_SECURE_COOKIES=

# Where a compilation runs: `process` (default) spawns a dedicated worker so a
# build never blocks the web server's event loop; `inline` keeps the old
# in-process behaviour for environments that cannot spawn.
# SIDEQUEST_COMPILER_ISOLATION=
#
# Server-side page retrieval, for official-source enrichment.
# SIDEQUEST_FETCH_MAX_BYTES=
# SIDEQUEST_FETCH_TIMEOUT_MS=
# SIDEQUEST_FETCH_MAX_REDIRECTS=

# --- The internal comparison harness at /labs ---
#
# Two variables authorise spending, and until this pass they were the two least
# documented things in the project: absent from this file entirely, while every
# free switch above had a paragraph.
#
# SIDEQUEST_BENCHMARK_MODE=fixture     # fixture | live
# SIDEQUEST_BENCHMARK_BUDGET_USD=      # a ceiling in dollars; both are required
#
# WARNING: setting both of the above makes /labs able to spend money.
#
# When live spending is configured — or the compiler is on the open stack, whose
# benchmark arm compiles real regions whatever the benchmark mode says — /labs
# requires this token, presented as an `x-sidequest-labs` header or a
# `sidequest_labs` cookie, and refuses the whole surface with a 404 when no
# token is set. With nothing billable configured /labs stays open, because a
# surface that cannot cost anything does not need a lock.
# SIDEQUEST_LABS_TOKEN=

# --- Not used yet ---

# Google Maps Platform. NOT part of the persisted product path, by decision.
#
# The adapters exist and work, behind switches that are permanently off here.
# Google's terms permit storing only `place_id` indefinitely and lat/lng for 30
# days — names, hours, ratings, durations and distances may not be persisted at
# all, which is incompatible with a stored compiled region and a stored plan.
# Nothing Google-derived may be persisted, displayed on a non-Google map, ranked
# from, or used to train a model. See .claude-private/BLOCKER-google-terms.md.
# GOOGLE_MAPS_API_KEY=

# B2: Anthropic. The ONE composition call that writes the trip draft
# (SIDEQUEST_COMPOSER_MODEL, default claude-sonnet-5), and — only when
# SIDEQUEST_RESEARCH_PROVIDER=anthropic — the optional compiler research.
# ANTHROPIC_API_KEY=
# SIDEQUEST_COMPOSER_MODEL=claude-sonnet-5
# SIDEQUEST_COMPOSITION_EFFORT=low     # low | medium | high
# SIDEQUEST_GENERATION_BUDGET_MS=120000
# ANTHROPIC_MODEL=claude-opus-5        # the research model

# B3: Supabase — NOT IMPLEMENTED IN THIS BUILD.
#
# Left here as the recorded intent, not as a switch: no code reads any of these
# names. Persistence is SQLite through `lib/db/client.ts`, and there is no
# account system at all — a trip belongs to the browser cookie that made it.
# Setting these does nothing.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# B4: Basemap. Either OpenFreeMap (vector, keyless, attribution rendered) or a
# raster tile template with its attribution. Unset: positions and routes are
# drawn on plain ground and the caption says so.
# SIDEQUEST_MAP_PROVIDER=openfreemap
# SIDEQUEST_MAP_STYLE=https://tiles.openfreemap.org/styles/positron
# SIDEQUEST_MAP_TILES=https://{z}/{x}/{y}.png
# SIDEQUEST_MAP_TILES_ATTRIBUTION=


# ===========================================================================
# SHIP V1 — THE PRODUCTION CONTRACT
#
# Everything above documents a capability. This section answers the only
# question a deployment asks: what must be set, what may be set, and what
# happens when it is not. Derived from the code that reads each name
# (`grep -r process.env`) and cross-checked against `npm run doctor`.
#
# NOTHING IS REQUIRED FOR THE APP TO START. Sidequest boots, serves and stays
# honest with an empty environment; what an empty environment costs you is
# stated per entry. There is exactly one name whose absence removes a feature a
# traveller would notice, and it is the first one.
# ===========================================================================

# --- Required for the product to do its job ---------------------------------

# The one composition call. Without it "Build my trip" cannot compose, and the
# product says so rather than pretending: every other surface still works.
# ANTHROPIC_API_KEY=

# Where the database file lives. MUST be an absolute path on a persistent
# volume in production — the default is relative to the working directory, which
# on most platforms is a container filesystem that is discarded on redeploy.
# The directory is created if missing. SQLite in WAL mode means exactly ONE
# writer process: run one instance, no autoscaling, no serverless.
# SIDEQUEST_DB_PATH=/data/sidequest.db

# --- Strongly recommended in production -------------------------------------

# The daily model-call ceiling for the whole deployment (default 800, with a
# tenth of it per caller). 800 is sized for a launch cohort, not for one person:
# on a private deployment set it to what you are willing to spend in a day.
# SIDEQUEST_DAILY_MODEL_CALLS=20

# The signing key for the ownership cookie's signature. Optional: with nothing
# set, the deployment mints one on first use and keeps it in the database, which
# is correct for a single instance. Set it explicitly if you ever run two
# processes against one volume, or if you want the key to survive a database
# restore from a different deployment.
# SIDEQUEST_SESSION_SECRET=

# How many proxy hops in front of this app you trust. Unset means the client's
# own `x-forwarded-for` is NOT believed, which is the safe default; the abuse
# fences then attribute a shared bucket rather than a forgeable one. Behind
# exactly one platform proxy (Railway, Fly, Render, a single nginx), set 1.
# SIDEQUEST_TRUSTED_PROXY_HOPS=1

# The `Secure` attribute on the ownership cookie is ON unless this says `off`.
# Leave it on: over plain HTTP on a real hostname the cookie is dropped and
# every trip looks like somebody else's. Deploy behind TLS.
# SIDEQUEST_SECURE_COOKIES=off

# The abuse fences are ON unless this is exactly `off`. Never set it in
# production; it exists for the browser suite, which is by definition the loop
# the fences stop.
# SIDEQUEST_ACTION_FENCES=off

# --- Strongly recommended: placing anything smaller than a country ----------

# The geocoder. Keyless, free, volunteer-run, and the difference between placing
# "Japan" and placing "Kyoto".
#
# Sidequest places a typed destination in three tiers: the local destination
# index if this deployment has one, then the bundled country reference (offline,
# any country), then this. Without it a country still places and a city does not,
# so the map on the way in shows the name rather than the place and "tell me when
# it is best" waits for the plan. Nothing breaks; the trip is simply thinner
# until the trip itself is created, which resolves it properly either way.
#
# Be a good citizen of a volunteer service: set a contact User-Agent.
# SIDEQUEST_GEOCODER_PROVIDER=nominatim
# SIDEQUEST_FETCH_USER_AGENT=Sidequest/1.0 (you@example.com)

# --- Optional, and what each one adds ---------------------------------------

# Global road routing outside the local router's coverage (`routing.global`).
# Both names are needed together. A free openrouteservice key from
# openrouteservice.org turns "no trustworthy travel time" into real measured
# minutes for direct legs anywhere in the world. Without it Sidequest is honest
# rather than wrong: legs carry its own estimate or an allowance, and the plan
# says which. This is the single largest quality gain available for the least
# configuration.
# SIDEQUEST_ROUTES_GLOBAL_PROVIDER=openrouteservice
# OPENROUTESERVICE_API_KEY=

# A local Valhalla instance, and the region its tiles actually cover. Declaring
# the coverage matters: undeclared, every pair is attempted and refused before
# the global router is tried.
# SIDEQUEST_ROUTES_PROVIDER=valhalla
# SIDEQUEST_ROUTES_URL=http://127.0.0.1:8002
# SIDEQUEST_ROUTES_COVERAGE=iceland

# Place identity and hours, for the plan itself (the geocoder above is separate
# and comes first). Google Places resolves and checks hours far better and is
# metered; nothing Google-derived is persisted beyond a place id (see
# BLOCKER-google-terms.md).
# SIDEQUEST_PLACE_BACKBONE=google-places
# SIDEQUEST_CONTACT_URL=https://example.com/contact

# Destination suggestions as you type. Without a seeded index the composer
# still works — it takes free text and resolves it — but nothing is offered.
# SIDEQUEST_DESTINATION_INDEX_SEED=../../e2e/support/destination-index.ndjson
# SIDEQUEST_ADMIN_TOKEN=            # gates the index write API; unset closes it

# Weather, climate normals, imagery, basemap: all keyless and all free.
# SIDEQUEST_WEATHER_PROVIDER=openmeteo
# SIDEQUEST_CLIMATE_PROVIDER=openmeteo
# SIDEQUEST_IMAGERY_PROVIDER=wikimedia
# SIDEQUEST_MAP_PROVIDER=openfreemap

# --- Deliberately off in production -----------------------------------------

# Shows the environment pill and the provider banner. This is developer
# furniture; a traveller must never see it. Off unless exactly `on`.
# SIDEQUEST_DIAGNOSTICS=on

# The offline composer and compiler. Real answers replayed from saved fixtures:
# the right way to demo or smoke-test without spending a call, and wrong in
# production, where a traveller would get somebody else's trip.
# SIDEQUEST_COMPOSER_PROVIDER=fixture
# SIDEQUEST_COMPILER_PROVIDER=fixture
# SIDEQUEST_FIXTURE_NOW=2026-08-13T17:30:00Z
