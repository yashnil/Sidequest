{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build --workspace=@sidequest/web",
    "watchPatterns": ["/apps/web/**", "/packages/**", "/package.json", "/package-lock.json", "/railway.json", "/.nvmrc"]
  },
  "deploy": {
    "startCommand": "npm run start --workspace=@sidequest/web",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "numReplicas": 1
  }
}
