node_modules/
.next/
out/
dist/
build/
# The App Router route segment `trips/[id]/build` (V8) is source, not build output.
!apps/web/src/app/**/build/
coverage/
*.tsbuildinfo
next-env.d.ts

# Every env file except the committed example. Listed exhaustively rather than
# as `.env*` so that `.env.example` stays tracked, and rather than as the three
# Next.js happens to document — `.env.production` was missing, which is the one
# a real key is most likely to end up in.
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test

# Destination index scan output: a regenerable 44 MB build input, produced by
# `apps/web/scripts/scan-divisions.mjs` and consumed once by the index refresh.
# Not source, and far too large to be.
**/data/*.ndjson
**/data/*.ndjson.state.json

# local SQLite development databases, wherever a workspace puts them
**/data/*.db
**/data/*.db-journal
**/data/*.db-wal
**/data/*.db-shm

test-results/
playwright-report/
.playwright/

.DS_Store

# Local Sidequest compilation logs
apps/web/data/compile-logs/*.log

# Compilation logs are runtime artifacts, wherever a workspace writes them (the doctor reads the newest one; nothing is committed).
**/data/compile-logs/

# Generated by apps/web/scripts/vendor-maplibre.mjs — the map renderer, served unbundled.
apps/web/public/vendor/

# ---------------------------------------------------------------------------
# Private working material — never published.
#
# These were excluded only in `.git/info/exclude` and in the machine's global
# ignore file. Neither is versioned, cloned or backed up, so the protection
# existed on exactly one computer. This repository has a public remote, which
# makes that the difference between a private note and a published one. Listed
# here so the exclusion travels with the code.
# ---------------------------------------------------------------------------
.claude-private/
CLAUDE.local.md
sidequest_master_prompt.md

# Claude Code local state: per-machine settings and runtime bookkeeping.
.claude/settings.local.json
.claude/scheduled_tasks.json
.claude/scheduled_tasks.lock
.claude/routines/.state/
.claude/worktrees/
.claude/checkpoints/
.claude/mailbox/
.claude/agent-registry.json
.claude/agent-memory-local/
.claude/first-run
.claude/assistant-daemon-state.json

# Founder benchmark exports: multi-megabyte PDFs of real trip comparisons.
# Regenerable, and not something a public remote should carry.
benchmarks/**/*.pdf
